{
  "_note": "Hypotheses from documentation, not measured quality. Each table value is a rules.json for data-quality-evaluation; 'source' keys are ignored by the profiler. Conflict-prone or inferred rules are labelled in 'source'.",
  "patients": {
    "placeholders": [
      "",
      "NA",
      "N/A",
      "NULL",
      "null",
      "None",
      "-",
      "?",
      "UNKNOWN",
      "9999",
      "-999",
      "999"
    ],
    "columns": {
      "subject_id": {
        "not_null": true,
        "unique": true,
        "source": "MIMIC:modules/hosp/patients.md"
      },
      "gender": {
        "not_null": true,
        "source": "patients.md (NOT NULL); values undocumented"
      },
      "anchor_age": {
        "not_null": true,
        "type": "number",
        "min": 18,
        "max": 91,
        "source": "patients.md (cap 91) vs concepts.md (300, conflict L6); adults only per PAPER"
      },
      "anchor_year": {
        "not_null": true,
        "type": "number",
        "source": "patients.md"
      },
      "anchor_year_group": {
        "not_null": true,
        "regex": "^\\d{4} - \\d{4}$",
        "source": "patients.md"
      },
      "dod": {
        "not_null": false,
        "type": "date",
        "source": "patients.md"
      }
    },
    "cross_field": []
  },
  "admissions": {
    "placeholders": [
      "",
      "NA",
      "N/A",
      "NULL",
      "null",
      "None",
      "-",
      "?",
      "UNKNOWN",
      "9999",
      "-999",
      "999"
    ],
    "columns": {
      "subject_id": {
        "not_null": true,
        "source": "admissions.md"
      },
      "hadm_id": {
        "not_null": true,
        "unique": true,
        "type": "number",
        "min": 2000000,
        "max": 2999999,
        "source": "admissions.md (upstream range; TinyEHR may differ)"
      },
      "admittime": {
        "not_null": true,
        "type": "date",
        "source": "admissions.md"
      },
      "dischtime": {
        "not_null": false,
        "type": "date",
        "source": "admissions.md"
      },
      "deathtime": {
        "not_null": false,
        "type": "date",
        "source": "admissions.md"
      },
      "admission_type": {
        "not_null": true,
        "allowed": [
          "AMBULATORY OBSERVATION",
          "DIRECT EMER.",
          "DIRECT OBSERVATION",
          "ELECTIVE",
          "EU OBSERVATION",
          "EW EMER.",
          "OBSERVATION ADMIT",
          "SURGICAL SAME DAY ADMISSION",
          "URGENT"
        ],
        "source": "admissions.md"
      },
      "hospital_expire_flag": {
        "not_null": false,
        "allowed": [
          "0",
          "1"
        ],
        "source": "admissions.md"
      }
    },
    "cross_field": [
      {
        "name": "discharge_not_before_admit",
        "expr": "dischtime.isna() | (dischtime >= admittime)",
        "source": "admissions.md; organ-donor accounts may legitimately fail (L18)"
      },
      {
        "name": "deathtime_implies_expire_flag",
        "expr": "deathtime.isna() | (hospital_expire_flag == 1)",
        "source": "admissions.md; inferred"
      },
      {
        "name": "ed_out_not_before_ed_reg",
        "expr": "edouttime.isna() | edregtime.isna() | (edouttime >= edregtime)",
        "source": "inferred"
      }
    ]
  },
